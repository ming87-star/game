<?xml version="1.0" encoding="utf-8"?>
<!-- 적응형 아이콘 (안드로이드 8 이상).
     바깥 33% 는 제조사가 잘라 냅니다. 그린 그림을 쓸 때 앞겹은 칸을 꽉
     채웁니다 — 66% 로 줄여 앉히면 마스크 테두리에 뒷겹 색이 비쳐서
     이음매가 보입니다 (까닭은 gen-icon.js 의 아이콘() 에 적어 두었습니다).
     **테마 아이콘(monochrome) 은 일부러 안 넣었습니다.** 그 칸은 알파만
     쓰고 색은 시스템이 갈아 끼우므로 그림을 넣으면 덩어리가 됩니다.
     빼 두면 테마 아이콘을 켜도 이 그림이 그대로 나옵니다.
     어두운 모드 그림은 mipmap-*-night 폴더에 따로 있습니다. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
